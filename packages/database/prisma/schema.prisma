/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model import_batches {
  id                          BigInt                   @id @default(autoincrement())
  batch_key                   String                   @unique
  dataset_profile_code        String
  environment_code            String
  status                      String                   @default("REGISTERED")
  initiated_by                String                   @default(dbgenerated("SESSION_USER"))
  correlation_id              String?
  expected_workbook_count     Int?
  source_manifest_hash_sha256 String?
  schema_contract_version     String
  dictionary_version          String
  started_at                  DateTime?                @db.Timestamptz(6)
  completed_at                DateTime?                @db.Timestamptz(6)
  created_at                  DateTime                 @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  metadata                    Json                     @default("{}")
  import_reconciliations      import_reconciliations[]
  import_workbooks            import_workbooks[]

  @@index([status, created_at(sort: Desc)], map: "import_batches_status_idx")
  @@schema("staging")
}

model import_reconciliations {
  id               BigInt         @id @default(autoincrement())
  batch_id         BigInt
  scope_type       String
  scope_key        String
  metric_code      String
  expected_numeric Decimal?       @db.Decimal
  actual_numeric   Decimal?       @db.Decimal
  expected_text    String?
  actual_text      String?
  matched          Boolean
  details          Json           @default("{}")
  created_at       DateTime       @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  import_batches   import_batches @relation(fields: [batch_id], references: [id], onUpdate: NoAction)

  @@unique([batch_id, scope_type, scope_key, metric_code], map: "import_reconciliation_unique")
  @@index([batch_id], map: "import_reconciliation_mismatch_idx", where: raw("(matched = false)"))
  @@schema("staging")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
