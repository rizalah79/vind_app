/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model memberships {
  id                                                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seed_key                                          String               @unique
  person_id                                         String               @db.Uuid
  organization_id                                   String               @db.Uuid
  workspace_id                                      String?              @db.Uuid
  status                                            String               @default("INVITED")
  effective_from                                    DateTime             @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  effective_to                                      DateTime?            @db.Timestamptz(6)
  invited_by_person_id                              String?              @db.Uuid
  accepted_at                                       DateTime?            @db.Timestamptz(6)
  retention_class_code                              String               @default("SEC")
  created_at                                        DateTime             @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  updated_at                                        DateTime             @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  persons_memberships_invited_by_person_idTopersons persons?             @relation("memberships_invited_by_person_idTopersons", fields: [invited_by_person_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  organizations                                     organizations        @relation(fields: [organization_id], references: [id], onUpdate: NoAction)
  persons_memberships_person_idTopersons            persons              @relation("memberships_person_idTopersons", fields: [person_id], references: [id], onUpdate: NoAction)
  retention_classes                                 retention_classes    @relation(fields: [retention_class_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  workspaces                                        workspaces?          @relation(fields: [workspace_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  scoped_assignments                                scoped_assignments[]

  @@unique([person_id, organization_id], map: "memberships_active_org_unique", where: raw("((workspace_id IS NULL) AND (status = 'ACTIVE'::text) AND (effective_to IS NULL))"))
  @@unique([person_id, organization_id, workspace_id], map: "memberships_active_workspace_unique", where: raw("((workspace_id IS NOT NULL) AND (status = 'ACTIVE'::text) AND (effective_to IS NULL))"))
  @@index([organization_id, status], map: "memberships_organization_idx")
  @@index([person_id, status], map: "memberships_person_idx")
  @@schema("access")
}

