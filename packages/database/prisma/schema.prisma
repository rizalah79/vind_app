generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "esm"
  runtime         = "nodejs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["access", "audit", "geo", "identity", "integration", "listing", "organization", "party", "privacy", "security", "staging"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model capabilities {
  code              String              @id
  domain_code       String
  action_code       String
  description       String
  is_sensitive      Boolean             @default(false)
  is_active         Boolean             @default(true)
  created_at        DateTime            @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  updated_at        DateTime            @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  role_capabilities role_capabilities[]

  @@schema("access")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model role_capabilities {
  role_code       String
  capability_code String
  effect          String       @default("ALLOW")
  created_at      DateTime     @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  created_by      String       @default(dbgenerated("SESSION_USER"))
  capabilities    capabilities @relation(fields: [capability_code], references: [code])
  roles           roles        @relation(fields: [role_code], references: [code])

  @@id([role_code, capability_code])
  @@index([capability_code], map: "role_capabilities_capability_idx")
  @@schema("access")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model roles {
  code               String               @id
  display_name       String
  description        String?
  role_scope         String
  is_system          Boolean              @default(true)
  is_active          Boolean              @default(true)
  created_at         DateTime             @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  updated_at         DateTime             @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  role_capabilities  role_capabilities[]
  scoped_assignments scoped_assignments[]

  @@schema("access")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model audit_events {
  id                    BigInt            @id @default(autoincrement())
  event_type            String
  action_code           String
  actor_account_key     String?
  actor_person_key      String?
  acting_membership_key String?
  acting_assignment_key String?
  target_schema         String
  target_relation       String
  target_key            String
  reason_code           String?
  correlation_id        String?
  request_id            String?
  before_state          Json?
  after_state           Json?
  metadata              Json              @default("{}")
  classification_code   String
  retention_class_code  String            @default("SEC")
  occurred_at           DateTime          @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  recorded_at           DateTime          @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  retention_classes     retention_classes @relation(fields: [retention_class_code], references: [code], onDelete: NoAction, onUpdate: NoAction)

  @@index([correlation_id], map: "audit_events_correlation_idx", where: raw("(correlation_id IS NOT NULL)"))
  @@index([target_schema, target_relation, target_key, occurred_at(sort: Desc)], map: "audit_events_target_idx")
  @@schema("audit")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model idempotency_keys {
  scope                String
  idempotency_key      String
  request_hash_sha256  String
  actor_key            String?
  correlation_id       String?
  status               String    @default("PROCESSING")
  response_status_code Int?
  response_body        Json?
  locked_until         DateTime? @db.Timestamptz(6)
  expires_at           DateTime  @db.Timestamptz(6)
  completed_at         DateTime? @db.Timestamptz(6)
  created_at           DateTime  @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  updated_at           DateTime  @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  @@id([scope, idempotency_key])
  @@index([status, expires_at], map: "idempotency_expiry_idx")
  @@schema("integration")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model outbox_events {
  id                BigInt    @id @default(autoincrement())
  event_key         String    @unique
  aggregate_schema  String
  aggregate_type    String
  aggregate_key     String
  aggregate_version BigInt
  event_type        String
  event_version     Int       @default(1)
  payload           Json
  headers           Json      @default("{}")
  correlation_id    String?
  causation_id      String?
  status            String    @default("PENDING")
  attempt_count     Int       @default(0)
  available_at      DateTime  @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  occurred_at       DateTime  @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  published_at      DateTime? @db.Timestamptz(6)
  last_error        String?
  created_at        DateTime  @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  @@index([aggregate_schema, aggregate_type, aggregate_key, aggregate_version], map: "outbox_aggregate_idx")
  @@index([available_at, id], map: "outbox_dispatch_idx", where: raw("(status = ANY (ARRAY['PENDING'::text, 'FAILED'::text]))"))
  @@schema("integration")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This table contains exclusion constraints and requires additional setup for migrations. Visit https://pris.ly/d/exclusion-constraints for more info.
model retention_assignments {
  id                        BigInt                    @id @default(autoincrement())
  target_schema             String
  target_relation           String
  aggregate_type            String                    @default("*")
  policy_version_id         BigInt
  effective_from            DateTime                  @db.Timestamptz(6)
  effective_to              DateTime?                 @db.Timestamptz(6)
  is_active                 Boolean                   @default(true)
  created_at                DateTime                  @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  created_by                String                    @default(dbgenerated("SESSION_USER"))
  retention_policy_versions retention_policy_versions @relation(fields: [policy_version_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("privacy")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model retention_classes {
  code                      String                      @id
  display_name              String
  description               String?
  is_active                 Boolean                     @default(true)
  created_at                DateTime                    @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  updated_at                DateTime                    @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  memberships               memberships[]
  pic_assignments           pic_assignments[]
  scoped_assignments        scoped_assignments[]
  audit_events              audit_events[]
  locations                 locations[]
  regions                   regions[]
  accounts                  accounts[]
  identity_links            identity_links[]
  channels                  channels[]
  organizations             organizations[]
  workspaces                workspaces[]
  consumer_profiles         consumer_profiles[]
  contact_points            contact_points[]
  persons                   persons[]
  retention_policy_versions retention_policy_versions[]
  data_access_logs          data_access_logs[]
  security_events           security_events[]

  @@schema("privacy")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This table contains exclusion constraints and requires additional setup for migrations. Visit https://pris.ly/d/exclusion-constraints for more info.
model retention_policy_versions {
  id                    BigInt                  @id @default(autoincrement())
  retention_class_code  String
  policy_version        Int
  jurisdiction_code     String                  @default("GLOBAL")
  disposal_action       String
  retention_seconds     BigInt?
  grace_seconds         BigInt?
  legal_hold_supported  Boolean                 @default(true)
  status                String                  @default("DRAFT")
  effective_from        DateTime                @db.Timestamptz(6)
  effective_to          DateTime?               @db.Timestamptz(6)
  policy_metadata       Json                    @default("{}")
  created_at            DateTime                @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  created_by            String                  @default(dbgenerated("SESSION_USER"))
  retention_assignments retention_assignments[]
  retention_classes     retention_classes       @relation(fields: [retention_class_code], references: [code], onDelete: NoAction, onUpdate: NoAction)

  @@unique([retention_class_code, jurisdiction_code, policy_version], map: "retention_policy_version_unique")
  @@schema("privacy")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
