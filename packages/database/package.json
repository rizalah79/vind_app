{
    "name":  "@vind/database",
    "version":  "0.0.0",
    "private":  true,
    "type":  "module",
    "main":  "./dist/index.js",
    "types":  "./dist/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js"
                          }
                },
    "files":  [
                  "dist",
                  "prisma/migrations"
              ],
    "scripts":  {
                    "prisma:validate":  "prisma validate",
                    "prisma:format":  "prisma format",
                    "prisma:generate":  "prisma generate",
                    "build":  "tsc -p tsconfig.json",
                    "check":  "npm run prisma:validate \u0026\u0026 npm run prisma:generate \u0026\u0026 npm run build",
                    "migrate":  "tsx src/migrate.ts",
                    "migrate:status":  "tsx src/migrate.ts --status",
                    "prisma:pull":  "prisma db pull",
                    "seed:smk":  "tsx src/seed-smk.ts apply",
                    "seed:smk:verify":  "tsx src/seed-smk.ts verify",
                    "seed:smk:cleanup":  "tsx src/seed-smk.ts cleanup --",
                    "seed:dec021":  "tsx src/seed-dec021.ts apply",
                    "seed:dec021:verify":  "tsx src/seed-dec021.ts verify",
                    "test:dec021": "tsx src/test-dec021-harness.ts",
                    "test:session": "tsx src/test-session-persistence.ts",
                    "test": "npm run check && npm run test:dec021 && npm run test:session"
                },
    "dependencies":  {
                         "@prisma/adapter-pg":  "7.9.1",
                         "@prisma/client":  "7.9.1",
                         "dotenv":  "17.4.2",
                         "pg":  "8.22.0"
                     },
    "devDependencies":  {
                            "@types/node":  "26.1.2",
                            "@types/pg":  "8.20.4",
                            "prisma":  "7.9.1",
                            "tsx":  "4.23.7",
                            "typescript":  "5.9.3"
                        }
}